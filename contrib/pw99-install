#!/bin/bash
# Winston 99 installer. Same script in every package tree.
# Destination is --webroot (or the commented default). Interactive does not ask for it.
# Verb: --webroot /srv/www/vapps/winston99.DOMAIN --nginx-server-name DOMAIN
# Config lives at webroot/config.php (PHP reads it there) and is linked to /etc/pw99/config.
set -euo pipefail

DB_NAME=pw99
DB_USER=pw99
DB_PASS=
DB_HOST=127.0.0.1
HOST=localhost
SITE_TITLE="Winston 99"
NGINX_NAME=
NGINX_LISTEN=80
WEBROOT=/srv/www/pw99
ETC=/etc/pw99
INTERACTIVE=0

while [ $# -gt 0 ]; do
  case "$1" in
    --db-name) DB_NAME=$2; shift 2;;
    --db-user) DB_USER=$2; shift 2;;
    --db-pass) DB_PASS=$2; shift 2;;
    --db-host) DB_HOST=$2; shift 2;;
    --url) HOST=$2; shift 2;;
    --host) HOST=$2; shift 2;;
    --site-title) SITE_TITLE=$2; shift 2;;
    --webroot) WEBROOT=$2; shift 2;;
    --etc) ETC=$2; shift 2;;
    --nginx-server-name) NGINX_NAME=$2; shift 2;;
    --nginx-listen) NGINX_LISTEN=$2; shift 2;;
    --interactive) INTERACTIVE=1; shift;;
    -h|--help)
      echo "pw99-install [--webroot DIR] [--etc DIR] [--db-name N] [--db-user U] [--db-pass P] [--host domain.tld] [--nginx-server-name HOST] [--interactive]"
      echo "  --webroot is a flag/default only. Interactive will not prompt for it."
      echo "  --host is everything after https:// (no scheme)."
      echo "  Verb example: pw99-install --webroot /srv/www/vapps/pw99.inkisaverb.com --host 99.inkisaverb.com --nginx-server-name 99.inkisaverb.com"
      exit 0;;
    *) echo "unknown $1"; exit 1;;
  esac
done

HOST=${HOST#http://}
HOST=${HOST#https://}

if [ "$INTERACTIVE" = "1" ]; then
  read -rp "Database name [$DB_NAME]: " x; DB_NAME=${x:-$DB_NAME}
  read -rp "Database user [$DB_USER]: " x; DB_USER=${x:-$DB_USER}
  read -rsp "Database password: " DB_PASS; echo
  read -rp "Public host, no https:// [$HOST]: " x; HOST=${x:-$HOST}
  read -rp "Nginx server_name (empty skip): " NGINX_NAME
fi

HERE=$(cd "$(dirname "$0")" && pwd)
if [ -f "$HERE/../index.php" ]; then
  APP_ROOT=$(cd "$HERE/.." && pwd)
elif [ -f "$HERE/index.php" ]; then
  APP_ROOT=$HERE
elif [ -f /usr/share/pw99/index.php ]; then
  APP_ROOT=/usr/share/pw99
else
  APP_ROOT=$HERE
fi

mkdir -p "$WEBROOT" "$ETC"
if [ "$WEBROOT" != "$APP_ROOT" ]; then
  mkdir -p "$WEBROOT"
  cp -a "$APP_ROOT"/. "$WEBROOT"/
  rm -f "$WEBROOT/config.php"
fi

CFG="$WEBROOT/config.php"
if [ ! -f "$CFG" ]; then
  cat > "$CFG" <<EOF
<?php
return [
    'configured' => true,
    'allow_create_super' => true,
    'host' => '${HOST}',
    'site_title' => '${SITE_TITLE}',
    'db' => [
        'host' => '${DB_HOST}',
        'port' => 3306,
        'name' => '${DB_NAME}',
        'user' => '${DB_USER}',
        'pass' => '${DB_PASS}',
        'charset' => 'utf8mb4',
    ],
    'mail' => [
        'transport' => 'mail',
        'from' => 'noreply@${HOST}',
        'from_name' => '${SITE_TITLE}',
        'smtp_host' => '127.0.0.1',
        'smtp_port' => 587,
        'smtp_user' => '',
        'smtp_pass' => '',
        'smtp_secure' => 'tls',
    ],
    'github' => 'https://github.com/JesseSteele/Winston99.git',
    'stream' => 'main',
    'oauth' => [
        'google' => ['id' => '', 'secret' => ''],
        'apple'  => ['id' => '', 'secret' => ''],
        'github' => ['id' => '', 'secret' => ''],
    ],
];
EOF
  chmod 0640 "$CFG"
fi
ln -sfn "$CFG" "$ETC/config"

if command -v mariadb >/dev/null && [ -n "$DB_PASS" ]; then
  mariadb -e "CREATE DATABASE IF NOT EXISTS ${DB_NAME}; CREATE USER IF NOT EXISTS '${DB_USER}'@'localhost' IDENTIFIED BY '${DB_PASS}'; GRANT ALL PRIVILEGES ON ${DB_NAME}.* TO '${DB_USER}'@'localhost'; FLUSH PRIVILEGES;" 2>/dev/null || true
  if [ -f "$WEBROOT/sql/schema.sql" ]; then
    mariadb "$DB_NAME" < "$WEBROOT/sql/schema.sql" 2>/dev/null || true
  fi
fi

NGINX_SRC=""
for c in "$HERE/pw99.conf" "$HERE/nginx/pw99.conf" /usr/share/pw99/nginx/pw99.conf; do
  [ -f "$c" ] && NGINX_SRC=$c && break
done
if [ -n "$NGINX_NAME" ] && [ -n "$NGINX_SRC" ]; then
  conf=/etc/nginx/http.d/pw99.conf
  [ -d /etc/nginx/sites-available ] && conf=/etc/nginx/sites-available/pw99
  sed -e "s/example.tld/$NGINX_NAME/g" -e "s#/srv/www/pw99#$WEBROOT#g" \
      -e "s/listen 80/listen $NGINX_LISTEN/" "$NGINX_SRC" > "$conf"
  [ -d /etc/nginx/sites-enabled ] && ln -sfn "$conf" /etc/nginx/sites-enabled/pw99
  nginx -t && systemctl reload nginx || true
fi

echo "Config: $CFG  (also $ETC/config)"
echo "Webroot: $WEBROOT"
echo "Open https://$HOST/install.php to create the first Superintendent, then set allow_create_super to false."
